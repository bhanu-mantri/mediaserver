# Copy to .env and fill in. Never share .env.
PUID=1000
PGID=1000
TZ=Asia/Kolkata

# ---- Surfshark via Gluetun ----
# Recommended: wireguard. Get the key at my.surfshark.com -> VPN -> Manual setup
#   -> Router -> WireGuard -> "I don't have a key pair" -> generate -> copy PRIVATE key.
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.14.0.2/16

# Alternative: VPN_TYPE=openvpn with service credentials from
#   my.surfshark.com -> VPN -> Manual setup -> Router -> OpenVPN -> Credentials
OPENVPN_USER=
OPENVPN_PASSWORD=

# Comma-separated, e.g. Netherlands,Switzerland
VPN_SERVER_COUNTRIES=Netherlands
